{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "full-jsonc",
  "main": "../src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // All ids below are dummy values for the sample.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "full-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "full-bucket" }],
  "kv_namespaces": [{ "binding": "CACHE", "id": "00000000000000000000000000000000" }],
  "durable_objects": {
    "bindings": [
      // A class this Worker exports.
      { "name": "ROOM", "class_name": "Room" },
      // A class exported by another Worker.
      { "name": "LOCK", "class_name": "Lock", "script_name": "full-toml" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // A Service Binding to a named entrypoint of another Worker.
  "services": [{ "binding": "RPC", "service": "full-toml", "entrypoint": "Rpc" }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "full-jobs" }],
    "consumers": [
      {
        "queue": "full-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "full-jobs-dlq"
      }
    ]
  },
  "ai": { "binding": "AI" },
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "full_events" }],
  "workflows": [{ "name": "full-flow", "binding": "FLOW", "class_name": "Flow" }],
  "vectorize": [{ "binding": "INDEX", "index_name": "full-index" }],
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000" }],
  "browser": { "binding": "BROWSER" },
  "send_email": [{ "name": "MAILER", "allowed_destination_addresses": ["team@example.com"] }],
  "images": { "binding": "IMAGES" },
  "version_metadata": { "binding": "VERSION" },
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 }
    }
  ],
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "full.example.com/*", "zone_name": "example.com" },
    { "pattern": "app.example.com", "custom_domain": true }
  ],
  "triggers": { "crons": ["0 3 * * *", "*/30 * * * *"] },
  "vars": { "ENVIRONMENT": "production" },
  // Nothing is inherited into an environment: bindings are written out again.
  "env": {
    "staging": {
      "name": "full-jsonc-staging",
      "vars": { "ENVIRONMENT": "staging" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "full-db-staging",
          "database_id": "00000000-0000-0000-0000-000000000001"
        }
      ],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "full-bucket-staging" }],
      "kv_namespaces": [{ "binding": "CACHE", "id": "00000000000000000000000000000001" }],
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "full-jobs-staging" }]
      },
      "routes": [{ "pattern": "staging.example.com", "custom_domain": true }],
      "triggers": { "crons": ["0 4 * * *"] }
    }
  }
}
